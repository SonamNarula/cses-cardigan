{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "C++: build active file",
      "type": "shell",
      "command": "/opt/homebrew/bin/g++-15",
      "args": [
        "-std=c++20",
        "-O2",
        "-Wall",
        "-Wextra",
        "-Wshadow",
        "-DLOCAL",
        "${file}",
        "-o",
        "${workspaceFolder}/bin/${fileBasenameNoExtension}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc",
      "presentation": {
        "clear": true,
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "C++: run active file",
      "type": "shell",
      "command": "${workspaceFolder}/bin/${fileBasenameNoExtension}",
      "dependsOn": "C++: build active file",
      "problemMatcher": [],
      "presentation": {
        "clear": false,
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
